    "AI capture isn't available on this device. You can still enter the recipe by hand.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura por IA no está disponible en este dispositivo. Aún puedes introducir la receta manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture par IA n'est pas disponible sur cet appareil. Vous pouvez toujours saisir la recette manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Erfassung ist auf diesem Gerät nicht verfügbar. Du kannst das Rezept weiterhin manuell eingeben."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-vastlegging is niet beschikbaar op dit apparaat. Je kunt het recept nog steeds handmatig invoeren."
          }
        }
      }
    },
