      }
    },
    "Recipe Raccoon uses ingredient densities to convert between volume and weight. It checks for updates once a day.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Raccoon usa las densidades de los ingredientes para convertir entre volumen y peso. Busca actualizaciones una vez al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Raccoon utilise les densités des ingrédients pour convertir entre volume et poids. Il recherche des mises à jour une fois par jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Raccoon nutzt Zutatendichten, um zwischen Volumen und Gewicht umzurechnen. Es sucht einmal täglich nach Aktualisierungen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Raccoon gebruikt ingrediëntdichtheden om tussen volume en gewicht om te rekenen. Het controleert één keer per dag op updates."
          }
        }
      }
    },
