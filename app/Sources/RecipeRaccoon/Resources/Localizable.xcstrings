    "The Idea": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La idea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'idée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Idee"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het idee"
          }
        }
      }
    },
    "Recipe sites bury the recipe under ads, pop-ups and life stories. Recipe Raccoon keeps just the recipe: type it, paste it or link it, check it once, and cook from a clean page.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las webs de recetas entierran la receta bajo anuncios, ventanas emergentes e historias de vida. Recipe Raccoon se queda solo con la receta: escríbela, pégala o enlázala, revísala una vez y cocina desde una página limpia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sites de recettes enfouissent la recette sous les publicités, les pop-ups et les récits de vie. Recipe Raccoon ne garde que la recette : tapez-la, collez-la ou importez-la depuis un lien, vérifiez-la une fois, et cuisinez depuis une page épurée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezeptseiten verstecken das Rezept unter Werbung, Pop-ups und Lebensgeschichten. Recipe Raccoon behält nur das Rezept: Tipp es ein, füg es ein oder verlinke es, prüf es einmal und koch von einer aufgeräumten Seite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Receptensites verstoppen het recept onder advertenties, pop-ups en levensverhalen. Recipe Raccoon houdt alleen het recept over: typ het, plak het of link ernaar, controleer het één keer en kook vanaf een overzichtelijke pagina."
          }
        }
      }
    },
    "Open Source": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código abierto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source"
          }
        }
      }
    },
    "Recipe Raccoon is open source under the MIT license. Anyone can read the code, check what the app does, and build it themselves.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Raccoon es de código abierto con licencia MIT. Cualquiera puede leer el código, comprobar qué hace la app y compilarla por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Raccoon est open source sous licence MIT. Tout le monde peut lire le code, vérifier ce que fait l'app et la compiler soi-même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Raccoon ist Open Source unter der MIT-Lizenz. Alle können den Code lesen, prüfen, was die App macht, und sie selbst bauen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Raccoon is open source onder de MIT-licentie. Iedereen kan de code lezen, controleren wat de app doet en hem zelf bouwen."
          }
        }
      }
    },
    "No Tracking": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin rastreo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun suivi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Tracking"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen tracking"
          }
        }
      }
    },
    "No account, no ads, no analytics, no tracking.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin anuncios, sin analíticas, sin rastreo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas de publicités, pas de statistiques d'utilisation, pas de suivi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, keine Werbung, keine Analysen, kein Tracking."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account, geen advertenties, geen analytics, geen tracking."
          }
        }
      }
    },
    "Your recipes stay on this device, or in your own iCloud if you turn on sync.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus recetas se quedan en este dispositivo, o en tu propio iCloud si activas la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos recettes restent sur cet appareil, ou dans votre propre iCloud si vous activez la synchronisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rezepte bleiben auf diesem Gerät oder in deiner eigenen iCloud, wenn du die Synchronisierung einschaltest."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je recepten blijven op dit apparaat, of in je eigen iCloud als je synchronisatie aanzet."
          }
        }
      }
    },
    "Recipe capture runs on your device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura de recetas se hace en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture des recettes se fait sur votre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erfassen von Rezepten läuft auf deinem Gerät."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het inlezen van recepten gebeurt op je apparaat."
          }
        }
      }
    },
    "The app only goes online to:": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app solo se conecta a internet para:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app ne se connecte à Internet que pour :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App geht nur für Folgendes online:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app gaat alleen online om:"
          }
        }
      }
    },
    "Fetch the recipe from a link you paste. That website sees the visit, as it would in a browser.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener la receta de un enlace que pegas. Esa web ve la visita, como la vería en un navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérer la recette d'un lien que vous collez. Ce site voit la visite, comme dans un navigateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Rezept von einem Link abrufen, den du einfügst. Diese Website sieht den Besuch wie in einem Browser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het recept ophalen van een link die je plakt. Die website ziet het bezoek, net als in een browser."
          }
        }
      }
    },
    "Sync your recipes through your own iCloud, if you turn it on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar tus recetas con tu propio iCloud, si lo activas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser vos recettes via votre propre iCloud, si vous l'activez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rezepte über deine eigene iCloud synchronisieren, wenn du das einschaltest."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je recepten synchroniseren via je eigen iCloud, als je dat aanzet."
          }
        }
      }
    },
    "Download ingredient densities from Recipe Raccoon's server. The app sends it nothing about you or your recipes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar las densidades de ingredientes del servidor de Recipe Raccoon. La app no le envía nada sobre ti ni sobre tus recetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger les densités des ingrédients depuis le serveur de Recipe Raccoon. L'app ne lui envoie rien sur vous ni sur vos recettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zutatendichten vom Server von Recipe Raccoon laden. Die App schickt ihm nichts über dich oder deine Rezepte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrediëntdichtheden downloaden van de server van Recipe Raccoon. De app stuurt de server niets over jou of je recepten."
          }
        }
      }
    },
