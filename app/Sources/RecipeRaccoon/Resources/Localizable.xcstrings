    "Moving your recipes…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moviendo tus recetas…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacement de vos recettes…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rezepte werden verschoben …"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je recepten worden verplaatst…"
          }
        }
      }
    },
    "With iCloud, your recipes sync to your other devices signed in to the same account. Switching back to this device keeps a copy of every recipe here and stops syncing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con iCloud, tus recetas se sincronizan con tus otros dispositivos que usan la misma cuenta. Si vuelves a este dispositivo, se guarda aquí una copia de cada receta y se deja de sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec iCloud, vos recettes se synchronisent avec vos autres appareils connectés au même compte. En revenant à cet appareil, une copie de chaque recette est conservée ici et la synchronisation s'arrête."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit iCloud werden deine Rezepte mit deinen anderen Geräten synchronisiert, die mit demselben Account angemeldet sind. Wechselst du zurück zu diesem Gerät, bleibt hier eine Kopie jedes Rezepts erhalten und die Synchronisierung endet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met iCloud worden je recepten gesynchroniseerd met je andere apparaten die met hetzelfde account zijn ingelogd. Schakel je terug naar dit apparaat, dan blijft hier een kopie van elk recept bewaard en stopt de synchronisatie."
          }
        }
      }
    },
    "iCloud sync isn't available in this build.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud no está disponible en esta versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud n'est pas disponible dans cette version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Synchronisierung ist in diesem Build nicht verfügbar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synchronisatie is niet beschikbaar in deze build."
          }
        }
      }
    },
    "iCloud is restricted on this device, so recipes can't sync.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud está restringido en este dispositivo, así que las recetas no se pueden sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est restreint sur cet appareil, les recettes ne peuvent donc pas être synchronisées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist auf diesem Gerät eingeschränkt, daher können Rezepte nicht synchronisiert werden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is beperkt op dit apparaat, dus recepten kunnen niet worden gesynchroniseerd."
          }
        }
      }
    },
    "iCloud is temporarily unavailable. Try again in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no está disponible temporalmente. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est temporairement indisponible. Réessayez dans un instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist vorübergehend nicht verfügbar. Versuche es gleich noch einmal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is tijdelijk niet beschikbaar. Probeer het zo meteen opnieuw."
          }
        }
      }
    },
    "Couldn't reach iCloud. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con iCloud. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre iCloud. Vérifiez votre connexion et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud konnte nicht erreicht werden. Überprüfe deine Verbindung und versuche es erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan iCloud niet bereiken. Controleer je verbinding en probeer het opnieuw."
          }
        }
      }
    },
    "Couldn't change where recipes are stored. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
