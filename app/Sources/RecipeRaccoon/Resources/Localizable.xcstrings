            "state": "translated",
            "value": "Der Speicherort der Rezepte konnte nicht geändert werden. Versuche es erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet wijzigen waar recepten worden bewaard. Probeer het opnieuw."
