            "state": "translated",
            "value": "Waar je je recepten bewaart"
          }
        }
      }
    },
    "Your recipes stay on this device. You can turn on iCloud later in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rezepte bleiben auf diesem Gerät. Du kannst iCloud später in den Einstellungen aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus recetas se quedan en este dispositivo. Puedes activar iCloud más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos recettes restent sur cet appareil. Vous pourrez activer iCloud plus tard dans Réglages."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je recepten blijven op dit apparaat. Je kunt iCloud later aanzetten in Instellingen."
          }
        }
      }
    },
    "Your recipes sync to your other devices signed in to the same account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rezepte werden mit deinen anderen Geräten synchronisiert, die mit demselben Account angemeldet sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus recetas se sincronizan con tus otros dispositivos que usan la misma cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos recettes se synchronisent avec vos autres appareils connectés au même compte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je recepten worden gesynchroniseerd met je andere apparaten die met hetzelfde account zijn ingelogd."
          }
