    "Paste or type a recipe below. AI pulls out the title, ingredients, and steps for you to review before saving.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega o escribe una receta a continuación. La IA extrae el título, los ingredientes y los pasos para que los revises antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez ou saisissez une recette ci-dessous. L'IA en extrait le titre, les ingrédients et les étapes afin que vous les examiniez avant d'enregistrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge unten ein Rezept ein oder gib es ein. Die KI extrahiert Titel, Zutaten und Schritte, damit du sie vor dem Speichern überprüfen kannst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak of typ hieronder een recept. AI haalt de titel, ingrediënten en stappen eruit, zodat je ze kunt controleren voordat je opslaat."
          }
        }
      }
    },
    "Capture": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar"
          }
        },
        "fr": {
