<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RecipeRaccoon.DensityApi.Application\RecipeRaccoon.DensityApi.Application.csproj" />
    <ProjectReference Include="..\RecipeRaccoon.DensityApi.Infrastructure\RecipeRaccoon.DensityApi.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Npgsql's provider depends on Relational 10.0.4; pin it to the EF Core version the
         Infrastructure project uses so the two don't conflict (MSB3277). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
